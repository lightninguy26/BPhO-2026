while atom not in atomic_number_dictionary_:
    print("Atom not found in the dictionary.")
    atom = input("Enter the name of the atom: ").lower()
atomic_number = atomic_number_dictionary_[atom]

for i in wavelength_transitions_dictionary:
    wavelength_ax=[]
    photon_energy_ax=[]
    end_energy=int(wavelength_transitions_dictionary[i][0])
    energy1=(-13.6 * atomic_number**2)/(end_energy**2)

    for j in range(5):
        start_energy=int(wavelength_transitions_dictionary[i][1]+j)
        energy2=(-13.6 * atomic_number**2)/(start_energy**2)
        photon_energy = energy2-energy1
        wavelength=con.h * con.c *1e9 / (photon_energy*con.e)
        co=wavelength_transitions_dictionary[i][2]

        plt.axvline(wavelength, color=co, linestyle=':', linewidth=1)
        ax.scatter(wavelength, photon_energy, color=co, marker='x', label=i if j == 0 else None)



ax.set_title(f"Bohr Model of a {atom} atom's photon emissions: Z = {atomic_number}", fontsize=12, pad=15)
ax.set_xlabel("Wavelength (nm)", fontsize = 7.5)
ax.set_ylabel("Photon Energy (eV)", fontsize = 10)
