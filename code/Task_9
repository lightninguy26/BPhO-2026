import math
from scipy import constants as con
import matplotlib.pyplot as plt
import numpy as np

rest = con.m_e
plank = con.h
light = con.c
charge = con.e
E = np.array([50, 100, 200, 500, 1000])
theta = np.linspace(0, np.pi, 200)
rl2=rest * light**2

plt.style.use("dark_background")
fig, ax = plt.subplots(figsize=(5, 5))

for j in E:
      i=j*1000*charge
      calc1 = ((i) / (rl2)) * (1 - np.cos(theta))
      ax.plot(np.degrees(theta), calc1, label=f"E = {j}keV")

ax.set_xlabel("Photon scattering angle θ /deg")
ax.set_ylabel("Δλ/λ")
ax.set_title("Compton scattering of X-ray photon off electron")

ax.set_xlim(left=0, right=180)
ax.set_ylim(bottom=0, top=4)

ax.grid(True)
ax.legend()

plt.tight_layout()
plt.show()


fig, ax = plt.subplots(figsize=(5, 5))

for j in E:
      
      i = j*1000*charge

      scattered_energy = i / (1 + (i / rl2) * (1 - np.cos(theta)))

      calc2 = np.sqrt(np.clip((1 - (rl2 / (rl2 + i - scattered_energy))**2), 0, None))

      ax.plot(np.degrees(theta), calc2, label=f"E = {j}keV")

ax.set_xlabel("Photon scattering angle θ /deg")
ax.set_ylabel("Electron recoil speed v/c")
ax.set_title("Compton scattering of X-ray photon off electron")

ax.set_xlim(left=0, right=180)
ax.set_ylim(bottom=0)

ax.grid(True)
ax.legend()

plt.tight_layout()
plt.show()


fig, ax = plt.subplots(figsize=(5, 5))

for j in E:
      
      i = j*1000*charge

      calc3 = np.arctan2(np.cos(theta / 2),(1 + i / rl2) * np.sin(theta / 2))

      ax.plot(np.degrees(theta), np.degrees(calc3), label=f"E = {j}keV")

ax.set_xlabel("Photon scattering angle θ /deg")
ax.set_ylabel("Electron recoil angle Φ /deg")
ax.set_title("Compton scattering of X-ray photon off electron")

ax.set_xlim(left=0, right=180)
ax.set_ylim(bottom=0, top = 90)

ax.grid(True)
ax.legend()

plt.tight_layout()
plt.show()
